from __future__ import annotations

from pathlib import Path
import math
import pandas as pd

from sabre.systems.ethanol_fermentation_system import create_ethanol_fermentation_system

DENSITY_ETHANOL_KG_L = 0.789
L_PER_GAL = 3.785


def safe_float(x, default=float("nan")):
    try:
        if x is None:
            return default
        return float(x)
    except (TypeError, ValueError):
        return default


def water_wt(stream) -> float:
    if stream is None or stream.F_mass <= 0 or "Water" not in stream.chemicals:
        return float("nan")
    return safe_float(stream.imass["Water"]) / safe_float(stream.F_mass)


def ethanol_kg_hr(stream) -> float:
    if stream is None or stream.F_mass <= 0 or "Ethanol" not in stream.chemicals:
        return 0.0
    return safe_float(stream.imass["Ethanol"], 0.0)


def ethanol_gal_hr(stream) -> float:
    kg_hr = ethanol_kg_hr(stream)
    return kg_hr / DENSITY_ETHANOL_KG_L / L_PER_GAL


def annualize_hourly(x, operating_days: float) -> float:
    return safe_float(x, 0.0) * safe_float(operating_days, 0.0) * 24.0


def mesp_per_gal(tea, ethanol_stream) -> float:
    price_per_kg_product = safe_float(tea.solve_price(ethanol_stream), float("nan"))

    if ethanol_stream is None or ethanol_stream.F_mass <= 0:
        return float("nan")

    ethanol_mass = ethanol_kg_hr(ethanol_stream)
    if ethanol_mass <= 0:
        return float("nan")

    wt_ethanol = ethanol_mass / safe_float(ethanol_stream.F_mass)
    if wt_ethanol <= 0:
        return float("nan")

    price_per_kg_ethanol = price_per_kg_product / wt_ethanol
    return price_per_kg_ethanol * DENSITY_ETHANOL_KG_L * L_PER_GAL


def total_unit_utility_cost_per_hr(system) -> float:
    total = 0.0
    for u in system.units:
        val = getattr(u, "utility_cost", 0.0)
        total += safe_float(val, 0.0)
    return total


def run_case(case_name: str, **kwargs) -> dict:
    system, tea, streams, _ = create_ethanol_fermentation_system(**kwargs)
    system.simulate()

    ethanol = streams["ethanol"]
    beer = streams["beer_raw"]

    operating_days = safe_float(getattr(tea, "operating_days", 330.0), 330.0)

    result = {
        "case": case_name,
        "include_feed_dewatering": kwargs.get("include_feed_dewatering", True),
        "include_post_pretreatment_dewatering": kwargs.get("include_post_pretreatment_dewatering", True),
        "MESP_$/gal": mesp_per_gal(tea, ethanol),
        "ethanol_kg_hr": ethanol_kg_hr(ethanol),
        "ethanol_gal_hr": ethanol_gal_hr(ethanol),
        "ethanol_gal_yr": annualize_hourly(ethanol_gal_hr(ethanol), operating_days),
        "beer_F_mass_kg_hr": safe_float(beer.F_mass),
        "beer_water_wt_frac": water_wt(beer),
        "feed_cake_F_mass_kg_hr": safe_float(streams["feed_dewatered_cake"].F_mass) if streams.get("feed_dewatered_cake") else float("nan"),
        "feed_cake_water_wt_frac": water_wt(streams.get("feed_dewatered_cake")),
        "ferm_feed_F_mass_kg_hr": safe_float(streams["dewatered_cake"].F_mass) if streams.get("dewatered_cake") else float("nan"),
        "ferm_feed_water_wt_frac": water_wt(streams.get("dewatered_cake")),
        "annual_utility_cost_$": annualize_hourly(total_unit_utility_cost_per_hr(system), operating_days),
        "VOC_$": safe_float(getattr(tea, "VOC", float("nan"))),
        "FOC_$": safe_float(getattr(tea, "FOC", float("nan"))),
        "TCI_$": safe_float(getattr(tea, "TCI", float("nan"))),
    }
    return result


def print_summary(df: pd.DataFrame) -> None:
    show_cols = [
        "case",
        "MESP_$/gal",
        "ethanol_gal_yr",
        "annual_utility_cost_$",
        "beer_water_wt_frac",
        "feed_cake_water_wt_frac",
        "ferm_feed_water_wt_frac",
        "TCI_$",
    ]
    d = df[show_cols].copy()

    print("\n=== Dewatering comparison ===")
    print(d.to_string(index=False))


def main() -> None:
    outdir = Path("results")
    outdir.mkdir(exist_ok=True)

    base_kwargs = dict(
        debug=False,
        feedstock_price=0.0,
        feed_total_flow_kg_hr=625000,
        feed_dewatering_moisture=0.60,
        dewatering_moisture=0.60,
        keep_feed_solubles=0.90,
        keep_post_solubles=0.99,
        X_alginate_to_sugars=0.90,
        X_fucoidan_to_sugars=0.90,
        X_mannitol_to_sugars=0.95,
        frac_seaweed_sugars_to_xylose=0.0,
        strip_ferm_aux_water=True,
    )

    cases = [
        (
            "baseline_both_dewatering",
            dict(
                include_feed_dewatering=True,
                include_post_pretreatment_dewatering=True,
            ),
        ),
        (
            "no_dewatering",
            dict(
                include_feed_dewatering=False,
                include_post_pretreatment_dewatering=False,
            ),
        ),
        (
            "post_pretreatment_only",
            dict(
                include_feed_dewatering=False,
                include_post_pretreatment_dewatering=True,
            ),
        ),
        (
            "feed_only",
            dict(
                include_feed_dewatering=True,
                include_post_pretreatment_dewatering=False,
            ),
        ),
    ]

    rows = []
    for case_name, case_kwargs in cases:
        kwargs = dict(base_kwargs)
        kwargs.update(case_kwargs)

        print(f"Running case: {case_name}")
        try:
            row = run_case(case_name, **kwargs)
            rows.append(row)
            print(
                f"  OK  MESP={row['MESP_$/gal']:.3f} $/gal, "
                f"Ethanol={row['ethanol_gal_yr']:.2f} gal/yr, "
                f"Utilities={row['annual_utility_cost_$']:.2f} $/yr"
            )
        except Exception as e:
            print(f"  FAIL  {e}")
            rows.append(
                {
                    "case": case_name,
                    "include_feed_dewatering": case_kwargs["include_feed_dewatering"],
                    "include_post_pretreatment_dewatering": case_kwargs["include_post_pretreatment_dewatering"],
                    "MESP_$/gal": float("nan"),
                    "ethanol_kg_hr": float("nan"),
                    "ethanol_gal_hr": float("nan"),
                    "ethanol_gal_yr": float("nan"),
                    "beer_F_mass_kg_hr": float("nan"),
                    "beer_water_wt_frac": float("nan"),
                    "feed_cake_F_mass_kg_hr": float("nan"),
                    "feed_cake_water_wt_frac": float("nan"),
                    "ferm_feed_F_mass_kg_hr": float("nan"),
                    "ferm_feed_water_wt_frac": float("nan"),
                    "annual_utility_cost_$": float("nan"),
                    "VOC_$": float("nan"),
                    "FOC_$": float("nan"),
                    "TCI_$": float("nan"),
                }
            )

    df = pd.DataFrame(rows)
    df.to_csv(outdir / "dewatering_comparison.csv", index=False)
    print_summary(df)
    print(f"\nSaved: {(outdir / 'dewatering_comparison.csv').resolve()}")


if __name__ == "__main__":
    main()